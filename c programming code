#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 100

typedef struct
{
    char customerID[20];
    char customerName[50];
    char contactNumber[20];

    char registrationNumber[20];
    char carModel[50];
    int manufactureYear;

    char serviceDate[20];
    char serviceType[50];
    int mileage;
    float serviceCost;
    char remarks[100];

    char partName[50];
    int quantity;
    float partCost;
    char replacementDate[20];
    int replacementInterval;

} CarService;

CarService records[MAX];
int count = 0;

/* Function Prototypes */

void addRecord();
void displayRecords();
void searchRecord();
