/* Add Record */

void addRecord()
{
    if (count >= MAX)
    {
        printf("\nStorage Full!\n");
        return;
    }

    printf("\n----- ADD CUSTOMER AND VEHICLE RECORD -----\n");

    printf("Enter Customer ID: ");
    scanf("%s", records[count].customerID);

    printf("Enter Customer Name: ");
    scanf(" %[^\n]", records[count].customerName);

    printf("Enter Contact Number: ");
    scanf("%s", records[count].contactNumber);

    printf("Enter Registration Number: ");
    scanf("%s", records[count].registrationNumber);

    printf("Enter Car Model: ");
    scanf(" %[^\n]", records[count].carModel);

    printf("Enter Manufacturing Year: ");
    scanf("%d", &records[count].manufactureYear);

    printf("\n----- SERVICE DETAILS -----\n");

    printf("Enter Service Date (DD/MM/YYYY): ");
    scanf("%s", records[count].serviceDate);

    printf("Enter Service Type: ");
    scanf(" %[^\n]", records[count].serviceType);

    printf("Enter Mileage: ");
    scanf("%d", &records[count].mileage);

    printf("Enter Service Cost: ");
    scanf("%f", &records[count].serviceCost);

    printf("Enter Remarks: ");
    scanf(" %[^\n]", records[count].remarks);

    printf("\n----- SPARE PART DETAILS -----\n");

    printf("Enter Part Name: ");
    scanf(" %[^\n]", records[count].partName);

    printf("Enter Quantity: ");
    scanf("%d", &records[count].quantity);

    printf("Enter Part Cost: ");
    scanf("%f", &records[count].partCost);

    printf("Enter Replacement Date: ");
    scanf("%s", records[count].replacementDate);

    printf("Enter Recommended Replacement Interval (days): ");
    scanf("%d", &records[count].replacementInterval);

    count++;

    printf("\nRecord Added Successfully!\n");
}

